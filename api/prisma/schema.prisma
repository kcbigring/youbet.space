// Off-chain record for youbet.space. The chain holds escrow, stakes, attestations
// and settlement; Postgres holds identity, groups, social data and reputation.
// The hash of the final wager terms is what links the two (Wager.termsHash).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // At runtime this is Neon's pooled endpoint. Migrations need the unpooled one:
  // `npm run prisma:migrate` swaps in DIRECT_URL when it is set. Declaring
  // directUrl here instead would make every Prisma command fail when it is not.
  url      = env("DATABASE_URL")
}

enum WagerStatus {
  DRAFT // created off-chain, not yet deployed
  OPEN // deployed, accepting participants
  LOCKED // funded, terms immutable
  SETTLED
  REFUNDED
  CANCELLED
}

enum ResolutionMethod {
  ATTESTATION
  ORACLE
}

enum GroupRole {
  OWNER
  MEMBER
}

enum ParticipantState {
  INVITED
  JOINED
  DECLINED
}

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  email         String?  @unique
  displayName   String?
  handle        String?  @unique
  /// ERC-4337 smart-account address, owned by the user's passkey. We never hold
  /// a key for it; this is how on-chain activity is mapped back to a person.
  walletAddress String?  @unique
  /// Signed in at least once. Says nothing about the phone being real.
  verified      Boolean  @default(false)
  /// Phone proven via Firebase. Required to fund a wager once
  /// REQUIRE_VERIFIED_PHONE is on; irrelevant while playing with test funds.
  phoneVerified Boolean  @default(false)
  firebaseUid   String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions       Session[]
  memberships    GroupMember[]
  ownedGroups    Group[]            @relation("GroupOwner")
  createdWagers  Wager[]            @relation("WagerCreator")
  participations WagerParticipant[]
  comments       Comment[]
  notifications  Notification[]
  invitesSent    Invite[]           @relation("InviteSender")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One-time SMS codes for sign-in and for invitations into a group or wager.
model Invite {
  id          String    @id @default(cuid())
  /// Null for a link invite — the sender does not need the recipient's number.
  phone       String?
  codeHash    String?
  /// URL-safe token behind /j/<token>. Possession is the credential: the
  /// inviter vouched for the recipient by texting it to them personally.
  linkToken   String?   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  wagerId     String?
  wager       Wager?    @relation(fields: [wagerId], references: [id], onDelete: Cascade)
  invitedById String?
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([phone, usedAt])
  @@index([linkToken])
  @@index([groupId])
}

model Group {
  id        String  @id @default(cuid())
  name      String
  ownerId   String
  owner     User    @relation("GroupOwner", fields: [ownerId], references: [id])
  /// Group id in the on-chain GroupRegistry, once mirrored.
  onchainId Int?
  imageUrl  String?

  // Governance defaults applied to new wagers in this group.
  maxStakeCents         Int              @default(10000) // $100 per person per wager
  maxPotCents           Int              @default(50000) // $500 total pot
  monthlyLimitCents     Int              @default(100000) // $1,000 per member per month
  defaultBondCents      Int              @default(100) // $1 resolution bond
  defaultResolution     ResolutionMethod @default(ATTESTATION)
  /// Attestation threshold in basis points, read as "strictly more than".
  defaultThresholdBps   Int              @default(5000)
  /// Hours between the event ending and the attestation window closing.
  resolutionWindowHours Int              @default(72)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members GroupMember[]
  wagers  Wager[]
  invites Invite[]
}

model GroupMember {
  id       String    @id @default(cuid())
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model Wager {
  id        String  @id @default(cuid())
  groupId   String?
  group     Group?  @relation(fields: [groupId], references: [id])
  creatorId String
  creator   User    @relation("WagerCreator", fields: [creatorId], references: [id])

  proposition String
  /// Label for each side, e.g. ["Texas wins", "Ohio State wins"].
  sideLabels  String[]
  category    String?

  stakeCents    Int
  bondCents     Int
  feeBps        Int @default(100)
  ownerSplitBps Int @default(0)

  resolutionMethod ResolutionMethod @default(ATTESTATION)
  thresholdBps     Int              @default(5000)
  oracleSource     String?

  fundingDeadline    DateTime
  eventDeadline      DateTime
  resolutionDeadline DateTime

  status      WagerStatus @default(DRAFT)
  winningSide Int?

  // On-chain linkage. Wagers live in one WagerBook contract keyed by id, so
  // there is no per-wager address any more.
  onchainId     Int?    @unique
  termsHash     String?
  txHash        String?
  chainId       Int?
  settledTxHash String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  settledAt DateTime?

  participants WagerParticipant[]
  comments     Comment[]
  invites      Invite[]

  @@index([groupId, status])
  @@index([creatorId])
}

model WagerParticipant {
  id      String @id @default(cuid())
  wagerId String
  wager   Wager  @relation(fields: [wagerId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  side  Int?
  state ParticipantState @default(INVITED)

  fundedAt     DateTime?
  fundedTxHash String?

  // Resolution duty — mirrors the on-chain record so reputation can be queried cheaply.
  attestedAt     DateTime?
  attestedChoice Int?
  conceded       Boolean   @default(false)

  /// Net result in cents once the wager settles. Positive means winnings.
  netCents Int?

  invitedAt DateTime @default(now())

  @@unique([wagerId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  wagerId   String
  wager     Wager    @relation(fields: [wagerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([wagerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  body      String
  wagerId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}
