# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=4000
APP_URL=https://youbet.space
CORS_ORIGINS=http://localhost:3000,https://youbet.space

# Postgres. On Neon, DATABASE_URL is the pooled endpoint (…-pooler.…) used at
# runtime and DIRECT_URL is the unpooled one, which migrations need. Vercel's
# Neon integration also emits POSTGRES_URL, PGHOST and a dozen other aliases for
# the same database — none of them are read here.
DATABASE_URL=postgresql://user:password@localhost:5432/youbet
DIRECT_URL=postgresql://user:password@localhost:5432/youbet

# Guards admin-only endpoints (/admin/*). Generate with: openssl rand -hex 32
API_KEY=

# Mixed into login-code hashes. Kept separate from API_KEY so rotating the admin
# key does not invalidate every pending login code. openssl rand -hex 32
OTP_PEPPER=

# ------------------------------------------------------- chain (Base)
# Base Sepolia = 84532, Base mainnet = 8453.
CHAIN_ID=84532
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_RPC=https://mainnet.base.org

# Relayer that deploys wagers and sponsors user gas.
DEPLOYER_PRIVATE_KEY=

# Written to deployments/<network>.json by contracts/scripts/deploy.js.
FACTORY_ADDRESS=
GROUP_REGISTRY_ADDRESS=
RESOLVER_REGISTRY_ADDRESS=
TREASURY_ADDRESS=

# Rate used to convert the product's dollar limits into native units.
ETH_USD=3000
# Largest gas top-up the relayer will sponsor for a single transaction.
MAX_GAS_TOPUP_ETH=0.01

# --------------------------------------------------- embedded wallets
# 32-byte hex key encrypting user signing keys at rest. Keep this in a secret
# manager, never in the repo. Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=

# --------------------------------------------------- risk controls
# Execution plan §9. Values are in cents.
MAX_STAKE_CENTS=10000
MAX_POT_CENTS=50000
MONTHLY_LIMIT_CENTS=100000

# ------------------------------------------------------------ SMS
# Without these, invite codes are logged to the console in development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ------------------------------------ natural-language wager parsing
# Optional. Without a key the API falls back to deterministic parsing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SESSION_TTL_DAYS=30
