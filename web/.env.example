# Base URL of the youbet API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Identity Platform web client (public by design — access is controlled by the
# authorized-domains allowlist, not by hiding these).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project

# Chain and smart accounts. Wallets are ERC-4337 accounts owned by a passkey,
# so there is no seed phrase and the platform holds no key.
NEXT_PUBLIC_CHAIN_ID=84532
# Paymaster that sponsors gas (e.g. Coinbase Developer Platform). Without it the
# user pays their own gas; nothing else changes.
NEXT_PUBLIC_PAYMASTER_URL=
NEXT_PUBLIC_FACTORY_ADDRESS=
