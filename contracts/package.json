{
  "name": "friendly-wager-contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "export-abi": "node scripts/export-abi.js",
    "sync-env": "node scripts/sync-env.js",
    "status": "node scripts/status.js",
    "faucet": "node scripts/faucet.js",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network base_sepolia && node scripts/sync-env.js base_sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network base && node scripts/sync-env.js base",
    "verify:mainnet": "node scripts/verify.js base",
    "verify:sepolia": "node scripts/verify.js base_sepolia"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "^1.55.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.0",
    "hardhat": "^2.22.0"
  }
}
